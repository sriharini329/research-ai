{
  "name": "research-ai-appium",
  "version": "1.0.0",
  "description": "Appium Android E2E tests for Research AI",
  "main": "index.js",
  "scripts": {
    "test": "mocha tests/**/*.js --timeout 120000 --reporter mochawesome --reporter-options reportDir=reports/html,reportFilename=index",
    "test:smoke": "mocha tests/smoke/*.js --timeout 120000"
  },
  "dependencies": {
    "chai": "^4.3.7",
    "dotenv": "^16.3.1",
    "exceljs": "^4.3.0",
    "fs-extra": "^11.2.0",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "webdriverio": "^8.11.2",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
